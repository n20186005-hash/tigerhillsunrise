---
import '../styles/global.css';

const pageTitle = 'टाइगर हिल सनराइज अब्जर्भेटरी | दार्जिलिङ';
const pageDescription = 'सेन्चल फरेस्टको टाइगर हिलबाट सूर्योदय, कञ्चनजङ्घा दृश्य, यात्रा, पार्किङ, शुल्क, नजिकका ठाउँ र व्यावहारिक सुझावहरूको स्थानीय मार्गदर्शिका।';
const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const socialImage = Astro.site ? new URL('/social-card.svg', Astro.site).toString() : undefined;

const images = {
  hero: 'https://upload.wikimedia.org/wikipedia/commons/8/8a/Kanchenjunga_from_Tiger_Hill_at_dawn.jpg',
  sunrise: 'https://upload.wikimedia.org/wikipedia/commons/d/d6/Sunrise_at_Tigerhill%2C_Darjeeling.jpg',
  viewpoint: 'https://upload.wikimedia.org/wikipedia/commons/2/2e/Tiger_Hill_sunrise_point%2C_Darjeeling.jpg',
  range: 'https://upload.wikimedia.org/wikipedia/commons/9/9d/Kanchenjunga_range_from_Tiger_Hill%2C_Darjeeling.jpg'
};

const touristAttraction = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  name: 'Tiger Hill Observatory / Sunrise Viewpoint',
  alternateName: 'टाइगर हिल सनराइज अब्जर्भेटरी',
  description: pageDescription,
  telephone: '+91 1800 212 1655',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Senchal Rd, Senchal Forest',
    addressRegion: 'West Bengal',
    postalCode: '734102',
    addressCountry: 'IN'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 26.994830356553706,
    longitude: 88.28265887709146
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '03:00',
    closes: '17:00'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '18354'
  },
  ...(pageUrl ? { url: pageUrl } : {})
};

const faqItems = [
  {
    q: 'सूर्योदय हेर्न कति बजे पुग्नु राम्रो हुन्छ?',
    a: 'भीड र सडकको अवस्था हेर्दा सूर्योदयभन्दा धेरै अगाडि पुग्नु राम्रो हुन्छ। धेरै यात्रु दार्जिलिङबाट करिब ३:००–३:३० बजेतिर निस्कन्छन्। मौसम र स्थानीय सवारी नियम परिवर्तन हुन सक्ने भएकाले अघिल्लो साँझ चालक वा होटलसँग समय पक्का गर्नुहोस्।'
  },
  {
    q: 'कञ्चनजङ्घा सधैं देखिन्छ?',
    a: 'होइन। दृश्य बादल, कुहिरो र मौसमी अवस्थामाथि निर्भर हुन्छ। सफा बिहानमा कञ्चनजङ्घाको शृङ्खलामाथि पहिलो प्रकाश देखिनु यहाँको मुख्य आकर्षण हो।'
  },
  {
    q: 'टिकट वा सवारी शुल्क कति लाग्छ?',
    a: 'प्रवेश, सवारी कुपन, पार्किङ वा अब्जर्भेटरीका शुल्क समयसँगै बदलिन सक्छन्। पुराना यात्रामार्गदर्शकमा छुट्टाछुट्टै सवारी र बैठक शुल्क उल्लेख छन्, तर तिनलाई वर्तमान आधिकारिक दर नमान्नुहोस्—त्यही दिन स्थानीय रूपमा पुष्टि गर्नुहोस्।'
  },
  {
    q: 'आफ्नै गाडी लिएर जान मिल्छ?',
    a: 'सूर्योदय समयमा सवारी नियन्त्रण, कुपन वा प्रवेश कट-अफ लागू हुन सक्छ। निजी वा सेल्फ-ड्राइभ गाडीका नियम पनि बदलिन सक्छन्, त्यसैले स्थानीय चालक प्रयोग गर्नु वा दार्जिलिङ प्रहरी/पर्यटन स्रोतसँग अग्रिम पुष्टि गर्नु सुरक्षित हुन्छ।'
  },
  {
    q: 'कति समय छुट्याउने?',
    a: 'दृश्यस्थलमै करिब १.५–२ घण्टा राख्नु उपयुक्त हुन्छ। दार्जिलिङबाट आवतजावत, बिहानको ट्राफिक र बाटोमा घूम वा बतासिया लुप जोड्ने हो भने आधा दिन सहज हुन्छ।'
  },
  {
    q: 'बच्चा वा ज्येष्ठ नागरिकसँग जान मिल्छ?',
    a: 'मिल्छ, तर चिसो, भीड, उकालो हिँडाइ र अँध्यारोमा प्रतीक्षालाई ध्यान दिनुपर्छ। तातो कपडा, पानी र टर्च उपयोगी हुन्छन्। पार्किङ टाढा परेमा केही दूरी पैदल हिँड्नुपर्ने हुन सक्छ।'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
};
---
<!doctype html>
<html lang="ne">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#10182d" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="ne_IN" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(touristAttraction)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <header class="hero" id="top">
      <div class="hero-media" aria-hidden="true">
        <img src={images.hero} alt="" width="1600" height="1067" fetchpriority="high" decoding="async" />
      </div>
      <div class="site-shell hero-grid">
        <nav class="nav" aria-label="मुख्य नेभिगेसन">
          <a href="#top" aria-label="टाइगर हिल मुख्य पृष्ठ"><img src="/logo.svg" alt="टाइगर हिल सनराइज" width="280" height="72" /></a>
          <div class="nav-links">
            <a href="#experience">सूर्योदय</a>
            <a href="#plan">योजना</a>
            <a href="#route">यातायात</a>
            <a href="#nearby">वरिपरि</a>
            <a href="#map">नक्सा</a>
          </div>
        </nav>

        <div class="hero-copy">
          <p class="eyebrow hero-kicker">Senchal Forest · Darjeeling</p>
          <h1>पहिलो उज्यालो<br />हिमालमा पर्छ।</h1>
          <p class="hero-lede">टाइगर हिलमा सूर्योदय आफैंभन्दा पहिले कञ्चनजङ्घाका चुचुरा उज्यालिन्छन्। चिसो, कुहिरो र अँध्यारो पार गरेर आउने त्यो केही मिनेट नै यहाँको यात्रा हो।</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#plan">बिहानको योजना हेर्नुहोस् <span aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href="https://maps.app.goo.gl/xpAf5Rx8gtBy7gkN9" target="_blank" rel="noreferrer">Google Maps खोल्नुहोस्</a>
          </div>
        </div>

        <div class="hero-strip" aria-label="छोटो जानकारी">
          <div class="stat"><small>Google मूल्याङ्कन</small><strong>4.5 / 5 · 18,354 समीक्षा</strong></div>
          <div class="stat"><small>उचाइ</small><strong>करिब 2,590 मिटर</strong></div>
          <div class="stat"><small>सूचीबद्ध समय</small><strong>03:00–17:00 · परिवर्तन सम्भव</strong></div>
          <div class="stat"><small>स्थान</small><strong>सेन्चल फरेस्ट, दार्जिलिङ</strong></div>
        </div>
      </div>
    </header>

    <main>
      <section class="dawn-band" id="experience">
        <div class="site-shell dawn-layout">
          <div>
            <p class="eyebrow" style="color:var(--dawn)">सूर्योदयको क्रम</p>
            <h2 class="section-title">अँध्यारोबाट<br />हिमालको सुनौलो धारसम्म</h2>
            <p class="copy">टाइगर हिलको अनुभव घडीभन्दा मौसमले तय गर्छ। सफा क्षितिज भएको बिहानमा कञ्चनजङ्घा सूर्योदयअघि नै गुलाबी–सुनौलो देखिन थाल्छ; धेरै सफा अवस्थामा टाढा सगरमाथा क्षेत्रसमेत देखिन सक्छ।</p>
            <div class="timeline">
              <div class="timeline-item"><time>03:00</time><div><strong>दार्जिलिङबाट प्रस्थान</strong><br /><span class="copy">उच्च सिजनमा भीडलाई समय दिनुहोस्।</span></div></div>
              <div class="timeline-item"><time>04:00+</time><div><strong>दृश्यस्थलमा ठाउँ रोज्नुहोस्</strong><br /><span class="copy">अँध्यारो, चिसो र हावाका लागि तयार हुनुहोस्।</span></div></div>
              <div class="timeline-item"><time>उषाकाल</time><div><strong>पहिलो प्रकाश कञ्चनजङ्घामा</strong><br /><span class="copy">सूर्य देखिनुअघि चुचुराहरू रंग बदल्न सक्छन्।</span></div></div>
            </div>
          </div>
          <figure class="photo-card">
            <img src={images.sunrise} alt="टाइगर हिलबाट देखिएको सूर्योदय" width="1200" height="1600" loading="lazy" decoding="async" />
            <figcaption class="photo-credit">Mouli Ghosh · CC BY-SA 4.0</figcaption>
          </figure>
        </div>
      </section>

      <section class="info-section" id="plan">
        <div class="site-shell">
          <div class="info-head">
            <div>
              <p class="eyebrow">बिहानको व्यावहारिक योजना</p>
              <h2 class="section-title">पहिले तयारी,<br />पछि दृश्य।</h2>
            </div>
            <p class="copy">यहाँको मुख्य चुनौती टिकटभन्दा चिसो, बादल र सूर्योदयअघिको ट्राफिक हो। समय, शुल्क र सवारी नियम बदलिन सक्छन्; त्यसैले तलको योजना स्थिर नियम होइन, यात्रा तयार पार्ने व्यावहारिक ढाँचा हो।</p>
          </div>

          <div class="cards">
            <article class="card">
              <div class="num">01</div>
              <h3>उत्तम समय</h3>
              <p><span class="highlight">अक्टोबर–नोभेम्बर र मार्च–मे</span> सफा दृश्यका लागि लोकप्रिय अवधि मानिन्छन्। तर कुनै मौसमले दृश्यको ग्यारेन्टी गर्दैन; अघिल्लो रात बादल र वर्षा पूर्वानुमान हेर्नुहोस्।</p>
            </article>
            <article class="card">
              <div class="num">02</div>
              <h3>सुझाइएको बसाइ</h3>
              <p>दृश्यस्थलमा <span class="highlight">१.५–२ घण्टा</span> राख्नुहोस्। सूर्योदयपछि भीड घटेपछि दृश्य र फोटोका लागि केही अतिरिक्त समय उपयोगी हुन्छ।</p>
            </article>
            <article class="card">
              <div class="num">03</div>
              <h3>टिकट / शुल्क</h3>
              <p>सवारी प्रवेश, कुपन, पार्किङ र अब्जर्भेटरी शुल्क <span class="highlight">परिवर्तनशील</span> हुन सक्छन्। अनलाइन पुराना दरलाई हालको आधिकारिक दर नमान्नुहोस्; चालक वा स्थानीय काउन्टरमा त्यही दिन पुष्टि गर्नुहोस्।</p>
            </article>
            <article class="card">
              <div class="num">04</div>
              <h3>के लगाउने</h3>
              <p>बिहानको तापक्रम दार्जिलिङ शहरभन्दा बढी चिसो महसुस हुन सक्छ। तहदार ज्याकेट, टोपी, हातमोजा र ग्रिप भएको जुत्ता उपयोगी हुन्छ।</p>
            </article>
            <article class="card">
              <div class="num">05</div>
              <h3>पार्किङ</h3>
              <p>शिखर नजिक पार्किङ <span class="highlight">सीमित र भीडभाडयुक्त</span> हुन सक्छ। जामका बेला गाडी तल रोकिएर केही दूरी उकालो हिँड्नुपर्ने सम्भावना राख्नुहोस्।</p>
            </article>
            <article class="card">
              <div class="num">06</div>
              <h3>दृश्य असफल भए?</h3>
              <p>कुहिरोले हिमाल छोपे पनि दार्जिलिङ फर्कँदा घूम, बतासिया लुप वा सेन्चल क्षेत्र जोडेर बिहानको यात्रा उपयोगी बनाउन सकिन्छ।</p>
            </article>
          </div>
        </div>
      </section>

      <section class="split-photo">
        <img src={images.range} alt="टाइगर हिलबाट देखिएको कञ्चनजङ्घा हिमशृङ्खला" width="1600" height="1067" loading="lazy" decoding="async" />
        <div class="split-copy">
          <p class="eyebrow">दृश्य पढ्ने तरिका</p>
          <h2 class="section-title">सूर्यतिर होइन,<br />पहिले हिमालतिर हेर्नुहोस्।</h2>
          <p class="copy">टाइगर हिलको विशेषता यही हो: क्षितिजबाट सूर्य निस्किनुअघि कञ्चनजङ्घाको बरफले प्रकाश समात्छ। राम्रो दृश्यको दिन फोटो खिच्ने क्रम पनि उल्टो राख्नुहोस्—पहिले हिमशृङ्खला, त्यसपछि सूर्योदय।</p>
        </div>
      </section>

      <section class="route" id="route">
        <div class="site-shell route-grid">
          <div>
            <p class="eyebrow">विस्तृत यातायात</p>
            <h2 class="section-title">दार्जिलिङबाट<br />रातमै यात्रा सुरु हुन्छ।</h2>
            <p class="copy">टाइगर हिल दार्जिलिङ शहरबाट करिब ११ किमि टाढा छ। सूर्योदय यात्राका लागि स्थानीय रिजर्भ ट्याक्सी वा साझा गाडी सामान्य विकल्प हुन्।</p>
            <div class="notice"><strong>महत्त्वपूर्ण:</strong> सूर्योदय समयमा सवारी कुपन, संख्या सीमा वा प्रवेश कट-अफ लागू हुन सक्छ। नियम समयअनुसार फेरिन सक्छ; अघिल्लो साँझ होटल/चालकसँग हालको व्यवस्था पुष्टि गर्नुहोस्।</div>
          </div>
          <div class="route-list">
            <div class="route-row"><strong>दार्जिलिङ</strong><div><b>स्थानीय ट्याक्सी / साझा गाडी</b><br /><span class="copy">सामान्यतया सबेरै प्रस्थान। ट्राफिक र जाँचका लागि अतिरिक्त समय राख्नुहोस्।</span></div></div>
            <div class="route-row"><strong>NJP</strong><div><b>न्यु जलपाइगुडी रेलवे स्टेशन</b><br /><span class="copy">पहिले दार्जिलिङ पुगेर बस्नु सबैभन्दा सहज; जिल्ला पर्यटन स्रोतले दार्जिलिङसम्म करिब ८८ किमि बताउँछ।</span></div></div>
            <div class="route-row"><strong>IXB</strong><div><b>बागडोगरा विमानस्थल</b><br /><span class="copy">दार्जिलिङतर्फ सडकमार्ग; जिल्ला स्रोतमा दूरी करिब ९० किमि उल्लेख छ।</span></div></div>
            <div class="route-row"><strong>फर्कँदा</strong><div><b>घूम → बतासिया लुप</b><br /><span class="copy">सूर्योदयपछि फर्कने बाटोमा सहजै जोड्न सकिने लोकप्रिय क्रम।</span></div></div>
          </div>
        </div>
      </section>

      <section class="gallery" aria-labelledby="gallery-title">
        <div class="site-shell">
          <p class="eyebrow">वास्तविक दृश्य</p>
          <h2 class="section-title" id="gallery-title" style="margin-bottom:38px">कुहिरो खुल्यो भने<br />दृश्यको स्केल बदलिन्छ।</h2>
          <div class="gallery-grid">
