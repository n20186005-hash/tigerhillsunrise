---
import '../styles/global.css';

const SITE = 'https://tigerhillsunrise.com';
const ATTRACTION_FULL_NAME = 'Tiger Hill Observatory / Sunrise Viewpoint';
const ATTRACTION_SHORT_NAME = 'Tiger Hill';
const ATTRACTION_NP = 'टाइगर हिल सनराइज अब्जर्भेटरी';
const CITY = 'Darjeeling';
const STATE = 'West Bengal';
const COUNTRY = 'India';
const POSTAL = '734102';
const LAT = 26.994830356553706;
const LNG = 88.28265887709146;
const MAPS_SHARE = 'https://maps.app.goo.gl/xpAf5Rx8gtBy7gkN9';
const MAPS_EMBED = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6323.2950556703145!2d88.28265887709146!3d26.994830356553706!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39e42fcb31e0451b%3A0x4b9ef68840f1a28d!2sTiger%20Hill%20Observatory%2F%20Sunrise%20Viewpoint!5e1!3m2!1sne!2sin!4v1789018848617!5m2!1sne!2sin';
const PHONE = '+91 1800 212 1655';
const LAST_UPDATED = '2026-09-10';

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : `${SITE}/`;
const heroImage = new URL('/images/tiger-hill-kanchenjunga-dawn.jpg', SITE).toString();
const orgLogo = new URL('/icons/icon-512.png', SITE).toString();

// --- TDK --------------------------------------------------------------------
const pageTitle = `${ATTRACTION_FULL_NAME} (${CITY}) - Visitor Guide & Location`;
const pageDescription = `Plan a visit to ${ATTRACTION_FULL_NAME} (${ATTRACTION_NP}) in ${CITY}, ${STATE}, ${COUNTRY}. Sunrise over Kanchenjunga, location map, timings, tickets, parking and nearby ${'Batasia Loop'} and ${'Ghoom Monastery'}.`;

// --- Image sources (external Wikimedia Commons, CC-licensed) ---------------
const images = {
  hero: 'https://upload.wikimedia.org/wikipedia/commons/8/8a/Kanchenjunga_from_Tiger_Hill_at_dawn.jpg',
  sunrise: 'https://upload.wikimedia.org/wikipedia/commons/d/d6/Sunrise_at_Tigerhill%2C_Darjeeling.jpg',
  viewpoint: 'https://upload.wikimedia.org/wikipedia/commons/2/2e/Tiger_Hill_sunrise_point%2C_Darjeeling.jpg',
  range: 'https://upload.wikimedia.org/wikipedia/commons/9/9d/Kanchenjunga_range_from_Tiger_Hill%2C_Darjeeling.jpg'
};
const imageAlts = {
  hero: `${ATTRACTION_FULL_NAME} - Dawn view of Kanchenjunga from ${CITY}, ${COUNTRY}`,
  sunrise: `${ATTRACTION_FULL_NAME} - First sunrise light over the Himalayas in ${CITY}`,
  viewpoint: `${ATTRACTION_SHORT_NAME} sunrise viewpoint in ${CITY} - main viewing platform`,
  range: `${ATTRACTION_FULL_NAME} - Panoramic view of the Kanchenjunga range from ${CITY}`
};

// --- JSON-LD @graph ---------------------------------------------------------
const attractionId = `${SITE}/#attraction`;
const organizationId = `${SITE}/#organization`;
const websiteId = `${SITE}/#website`;

const webSiteNode = {
  '@type': 'WebSite',
  '@id': websiteId,
  url: SITE,
  name: `${ATTRACTION_FULL_NAME} - Visitor Guide (${CITY})`,
  inLanguage: 'ne',
  publisher: { '@id': organizationId }
};
const organizationNode = {
  '@type': 'Organization',
  '@id': organizationId,
  name: 'tigerhillsunrise.com',
  url: SITE,
  logo: { '@type': 'ImageObject', url: orgLogo, width: 512, height: 512 }
};
const webPageNode = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageTitle,
  description: pageDescription,
  inLanguage: 'ne',
  isPartOf: { '@id': websiteId },
  about: { '@id': attractionId },
  primaryImageOfPage: { '@type': 'ImageObject', url: heroImage },
  datePublished: '2026-09-10',
  dateModified: LAST_UPDATED,
  publisher: { '@id': organizationId }
};
const attractionNode = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': attractionId,
  name: ATTRACTION_FULL_NAME,
  alternateName: [
    ATTRACTION_SHORT_NAME,
    'Tiger Hill Sunrise',
    `${CITY} ${ATTRACTION_FULL_NAME}`,
    ATTRACTION_NP
  ],
  description:
    `${ATTRACTION_FULL_NAME} is a celebrated Himalayan sunrise viewpoint at 2,590 m (8,482 ft) in Senchal Forest above ${CITY}, ${STATE}, ${COUNTRY}, famed for the first light striking Mount Kanchenjunga at dawn.`,
  url: pageUrl,
  image: [heroImage],
  isAccessibleForFree: true,
  publicAccess: true,
  telephone: PHONE,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Senchal Rd, Senchal Forest',
    addressLocality: CITY,
    addressRegion: STATE,
    postalCode: POSTAL,
    addressCountry: 'IN'
  },
  geo: { '@type': 'GeoCoordinates', latitude: LAT, longitude: LNG },
  hasMap: MAPS_SHARE,
  sameAs: [
    MAPS_SHARE,
    'https://darjeeling.gov.in/tourist-place/tiger-hill/',
    'https://www.incredibleindia.gov.in/en/west-bengal/darjeeling/tiger-hill',
    'https://www.wbtourism.gov.in/',
    'https://en.wikipedia.org/wiki/Tiger_Hill,_Darjeeling'
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '03:00',
    closes: '17:00'
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '4.5',
    reviewCount: '18354',
    bestRating: '5',
    worstRating: '1'
  },
  touristType: ['Viewpoint', 'Observatory'],
  containedInPlace: { '@type': 'Place', name: 'Senchal Wildlife Sanctuary, Darjeeling' }
};
const breadcrumbNode = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE + '/' },
    { '@type': 'ListItem', position: 2, name: `${CITY}, ${STATE}`, item: `${SITE}/#location` },
    { '@type': 'ListItem', position: 3, name: ATTRACTION_FULL_NAME, item: pageUrl }
  ]
};

// --- FAQ (8 items, visible copy matches schema) ----------------------------
const faqItems = [
  {
    q: 'सूर्योदय हेर्न कति बजे पुग्नु राम्रो हुन्छ?',
    a: 'भीड र सडकको अवस्था हेर्दा सूर्योदयभन्दा धेरै अगाडि पुग्नु राम्रो हुन्छ। धेरै यात्रु दार्जिलिङबाट करिब ३:००–३:३० बजेतिर निस्कन्छन्। मौसम र स्थानीय सवारी नियम परिवर्तन हुन सक्ने भएकाले अघिल्लो साँझ चालक वा होटलसँग समय पक्का गर्नुहोस्।'
  },
  {
    q: 'कञ्चनजङ्घा सधैं देखिन्छ?',
    a: 'होइन। दृश्य बादल, कुहिरो र मौसमी अवस्थामाथि निर्भर हुन्छ। सफा बिहानमा कञ्चनजङ्घाको शृङ्खलामाथि पहिलो प्रकाश देखिनु यहाँको मुख्य आकर्षण हो।'
  },
  {
    q: 'टिकट वा सवारी शुल्क कति लाग्छ?',
    a: 'प्रवेश, सवारी कुपन, पार्किङ वा अब्जर्भेटरीका शुल्क समयसँगै बदलिन सक्छन्। पुराना यात्रामार्गदर्शकमा छुट्टाछुट्टै सवारी र बैठक शुल्क उल्लेख छन्, तर तिनलाई वर्तमान आधिकारिक दर नमान्नुहोस्—त्यही दिन स्थानीय रूपमा पुष्टि गर्नुहोस्।'
  },
  {
    q: 'आफ्नै गाडी लिएर जान मिल्छ?',
    a: 'सूर्योदय समयमा सवारी नियन्त्रण, कुपन वा प्रवेश कट-अफ लागू हुन सक्छ। निजी वा सेल्फ-ड्राइभ गाडीका नियम पनि बदलिन सक्छन्, त्यसैले स्थानीय चालक प्रयोग गर्नु वा दार्जिलिङ प्रहरी/पर्यटन स्रोतसँग अग्रिम पुष्टि गर्नु सुरक्षित हुन्छ।'
  },
  {
    q: 'कति समय छुट्याउने?',
    a: 'दृश्यस्थलमै करिब १.५–२ घण्टा राख्नु उपयुक्त हुन्छ। दार्जिलिङबाट आवतजावत, बिहानको ट्राफिक र बाटोमा घूम वा बतासिया लुप जोड्ने हो भने आधा दिन सहज हुन्छ।'
  },
  {
    q: 'बच्चा वा ज्येष्ठ नागरिकसँग जान मिल्छ?',
    a: 'मिल्छ, तर चिसो, भीड, उकालो हिँडाइ र अँध्यारोमा प्रतीक्षालाई ध्यान दिनुपर्छ। तातो कपडा, पानी र टर्च उपयोगी हुन्छन्। पार्किङ टाढा परेमा केही दूरी पैदल हिँड्नुपर्ने हुन सक्छ।'
  },
  {
    q: `${ATTRACTION_FULL_NAME} कहाँ अवस्थित छ?`,
    a: `${ATTRACTION_FULL_NAME} सेन्चल रोड, सेन्चल फरेस्ट, ${CITY}, ${STATE} ${POSTAL}, ${COUNTRY} मा अवस्थित छ। दार्जिलिङ शहरबाट करिब ११ किमि उत्तरमा रहेको यो दृश्यस्थल सेन्चल वन्यजन्तु अभयारण्यभित्र पर्छ।`
  },
  {
    q: `${ATTRACTION_SHORT_NAME} भ्रमण निःशुल्क छ?`,
    a: 'खुला सूर्योदय दृश्यस्थल सार्वजनिक ठाउँ हो र प्रवेश सामान्यतया निःशुल्क छ। तर सवारी कुपन, पार्किङ र अब्जर्भेटरी डेकको छुट्टै टिकट लाग्न सक्छ; हालको दर स्थानीय काउन्टर वा अधिकारिक स्रोतमा पुष्टि गर्नुहोस्।'
  }
];

const faqNode = {
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};

const graphLd = {
  '@context': 'https://schema.org',
  '@graph': [webSiteNode, organizationNode, webPageNode, attractionNode, breadcrumbNode, faqNode]
};

// --- Landmark cards (additive) ---------------------------------------------
const landmarks = [
  {
    tag: 'रेलवे ल्यान्डमार्क',
    name: 'बतासिया लुप',
    desc: 'दार्जिलिङ हिमालयन रेलवेको गोलाकार ट्र्याक, गोर्खा युद्ध स्मारक र खुला हिमाली दृश्य। टाइगर हिल फर्कने बाटोमा लगभग ५ किमि दार्जिलिङबाट टाढा सहज स्टप।'
  },
  {
    tag: 'बौद्ध गुम्बा',
    name: 'घूम मठ (सम्टेन छोलिङ)',
    desc: 'सम्टेन छोलिङ गुम्बा घूम (Ghoom) मा रहेको १८७५ को प्रसिद्ध बौद्ध गुम्बा हो। दार्जिलिङबाट करिब ८ किमि र टाइगर हिल जाने बाटोमा सजिलै जोडिन्छ।'
  },
  {
    tag: 'वन्यजन्तु अभयारण्य',
    name: 'सेन्चल वन्यजन्तु अभयारण्य',
    desc: 'सेन्चल रेन्जमा फैलिएको वन्यजन्तु अभयारण्य; टाइगर हिल यही परिधिभित्र पर्छ। चरा, गोरालगायतका हिमाली जीवजन्तु र सेन्चल तालको लागि चिनिन्छ।'
  },
  {
    tag: 'UNESCO सम्पदा',
    name: 'दार्जिलिङ हिमालयन रेलवे',
    desc: '१८८१ मा स्थापित विश्वप्रसिद्ध «टोय ट्रेन» रेलमार्ग; १९९९ देखि युनेस्को विश्व सम्पदा सूचीमा सूचीकृत। बतासिया लुप र घूम स्टेशन यसै रेलमार्गका भाग हुन्।'
  },
  {
    tag: 'शान्ति स्तूप',
    name: 'दार्जिलिङ शान्ति स्तूप (जापानीज टेम्पल)',
    desc: '१९७२ मा स्थापित यो सेतो शान्ति स्तूप दार्जिलिङको प्रमुख दर्शनीय स्थल हो; टाइगर हिल भ्रमणसँगै जोड्न सकिने रमणीय दृश्य बिन्दु।'
  }
];
---
<!doctype html>
<html lang="ne">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#10182d" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="ne" href={pageUrl} />
    <link rel="alternate" hreflang="x-default" href={pageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={ATTRACTION_FULL_NAME} />
    <meta property="og:locale" content="ne_IN" />
    <meta property="og:locale:alternate" content="en_IN" />
    <meta property="og:locale:alternate" content="hi_IN" />
    <meta property="og:image" content={heroImage} />
    <meta property="og:image:secure_url" content={heroImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1067" />
    <meta property="og:image:alt" content={`${ATTRACTION_FULL_NAME} - Dawn view of Kanchenjunga from ${CITY}, ${COUNTRY}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={heroImage} />
    <meta name="twitter:image:alt" content={`${ATTRACTION_FULL_NAME} - Dawn view of Kanchenjunga from ${CITY}, ${COUNTRY}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graphLd)} />
  </head>
  <body>
    <header class="hero" id="top">
      <div class="hero-media" aria-hidden="true">
        <img src={images.hero} alt="" width="1600" height="1067" fetchpriority="high" decoding="async" />
      </div>
      <div class="site-shell hero-grid">
        <nav class="nav" aria-label="मुख्य नेभिगेसन">
          <a href="#top" aria-label="टाइगर हिल मुख्य पृष्ठ"><img src="/logo.svg" alt="टाइगर हिल सनराइज" width="280" height="72" /></a>
          <div class="nav-links">
            <a href="#about">सूर्योदय</a>
            <a href="#plan">योजना</a>
            <a href="#location">यातायात</a>
            <a href="#landmarks">वरिपरि</a>
            <a href="#history">इतिहास</a>
            <a href="#sources">स्रोत</a>
          </div>
        </nav>

        <div class="hero-copy">
          <p class="eyebrow hero-kicker">Senchal Forest · Darjeeling · West Bengal · India</p>
          <h1 class="hero-title">{ATTRACTION_FULL_NAME}<br /><span class="hero-title-sub">({ATTRACTION_NP} — {CITY})</span></h1>
          <p class="hero-lede">पहिलो उज्यालो हिमालमा पर्छ। टाइगर हिलमा सूर्योदय आफैंभन्दा पहिले कञ्चनजङ्घाका चुचुरा उज्यालिन्छन्। चिसो, कुहिरो र अँध्यारो पार गरेर आउने त्यो केही मिनेट नै यहाँको यात्रा हो।</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#plan">बिहानको योजना हेर्नुहोस् <span aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href={MAPS_SHARE} target="_blank" rel="noopener noreferrer">Google Maps खोल्नुहोस्</a>
          </div>
        </div>

        <div class="hero-strip" aria-label="छोटो जानकारी">
          <div class="stat"><small>Google मूल्याङ्कन</small><strong>4.5 / 5 · 18,354 समीक्षा</strong></div>
          <div class="stat"><small>उचाइ</small><strong>करिब 2,590 मिटर (8,482 फिट)</strong></div>
          <div class="stat"><small>सूचीबद्ध समय</small><strong>03:00–17:00 · परिवर्तन सम्भव</strong></div>
          <div class="stat"><small>स्थान</small><strong>सेन्चल फरेस्ट, दार्जिलिङ</strong></div>
        </div>
      </div>
    </header>

    <main>
      <!-- ============ About (entity-bound first paragraph + breadcrumb) ============ -->
      <section class="about" id="about">
        <div class="site-shell about-grid">
          <div class="about-lede">
            <p class="eyebrow">Entity overview</p>
            <h2 class="section-title">About {ATTRACTION_FULL_NAME} <span class="kicker-np-dark">({ATTRACTION_NP} · {CITY})</span></h2>
            <p>
              Welcome to <strong>{ATTRACTION_FULL_NAME}</strong>, widely recognized as the central sunrise viewpoint — <strong>{ATTRACTION_SHORT_NAME}</strong> — of the Eastern Himalayas. Located in the heart of <strong>Senchal Forest</strong> above <strong>{CITY}</strong>, <strong>{STATE}</strong>, <strong>{COUNTRY}</strong>, this destination serves as a primary hub for travellers visiting the region.
            </p>
            <p>
              यो 2,590 मिटर उचाइको दृश्यस्थल कञ्चनजङ्घा (8,586 मि) को पहिलो प्रकाशको लागि विश्वप्रसिद्ध छ; सफा बिहानमा सगरमाथा, ल्होत्से र मकालुसम्म देखिन सक्छ।
              When visiting <strong>{ATTRACTION_FULL_NAME}</strong>, visitors can easily explore surrounding historical landmarks and points of interest, including <strong>Batasia Loop</strong> and <strong>Ghoom Monastery (Samten Choling)</strong>.
            </p>
            <nav class="breadcrumb-trail" aria-label="Breadcrumb">
              <a href="/">{ATTRACTION_FULL_NAME}</a>
              <span class="sep" aria-hidden="true">→</span>
              <a href="#location">{CITY}</a>
              <span class="sep" aria-hidden="true">→</span>
              <a href="#location">{STATE}</a>
              <span class="sep" aria-hidden="true">→</span>
              <span class="crumb-current">{COUNTRY}</span>
            </nav>
          </div>
          <aside class="quick-facts" aria-label="Quick facts">
            <h3>Quick facts</h3>
            <dl>
              <div class="row"><dt>Official name</dt><dd>{ATTRACTION_FULL_NAME}</dd></div>
              <div class="row"><dt>Type</dt><dd>Himalayan sunrise viewpoint &amp; observatory</dd></div>
              <div class="row"><dt>Elevation</dt><dd>2,590 m (8,482 ft)</dd></div>
              <div class="row"><dt>City</dt><dd>{CITY}, {STATE}</dd></div>
              <div class="row"><dt>Postal code</dt><dd>{POSTAL}, {COUNTRY}</dd></div>
              <div class="row"><dt>Distance</dt><dd>~11 km from Darjeeling town</dd></div>
              <div class="row"><dt>Coordinates</dt><dd>26.9948° N · 88.2827° E</dd></div>
